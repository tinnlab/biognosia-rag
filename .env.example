# Biognosia RAG — environment configuration. Copy to `.env` and edit.
#
# Only variables that are set (non-empty) override the defaults in
# config/rag-web.conf. Secrets belong here and never in the committed config.
# `.env` is gitignored.

# ══════════════════════════════════════════════════════════════════════════════
#  FILL IN ONE THING: your own OpenAI API key, in section (B) below.
#
#  The knowledge-base section (A) is already complete. Those accounts are
#  READ-ONLY and deliberately public — they are published with the paper so that
#  anyone can reproduce our results. You do not need to request access, and
#  there is nothing to ask us for.
#
#  They address the local ports opened by the tunnel client, so start that
#  first and leave it running:
#
#      docker compose -f docker-compose.tunnel.yml up -d
# ══════════════════════════════════════════════════════════════════════════════

# ── (A) Knowledge base — already configured, read-only, public ────────────────

# Milvus. The credentials ride INSIDE the host value on purpose: the adapter
# builds the URI as http://{host}:{port} and pymilvus parses user:password@ back
# out of it. There is deliberately no separate username/password variable.
BIOGNOSIA_MILVUS_HOST=bio_public:acaf205f6cff5dca14112fda9ef194910391e61ebd0f142ca9cdd620404ca651@127.0.0.1
BIOGNOSIA_MILVUS_PORT=18110

# Neo4j. Credentials travel separately from the URI. Neo4j Community has no
# role-based access control, so there is no separate public account — the whole
# server is read-only by configuration instead.
BIOGNOSIA_NEO4J_URI=bolt://127.0.0.1:18111
BIOGNOSIA_NEO4J_USERNAME=neo4j
BIOGNOSIA_NEO4J_PASSWORD=biognosia2024

# Redis. No authentication.
BIOGNOSIA_REDIS_HOST=127.0.0.1
BIOGNOSIA_REDIS_PORT=18112
# BIOGNOSIA_REDIS_PASSWORD=

# MongoDB — paper metadata for citations. Keep ?authSource=admin: the
# bio_public user lives in the admin database, not in paper_db.
BIOGNOSIA_MONGODB_URI=mongodb://bio_public:182df9383eab28468c03660f8095a578b2b9d31c5a12aeb4270e051d693168a9@127.0.0.1:18113/?authSource=admin

# Elasticsearch — BM25/hybrid keyword search. No authentication.
BIOGNOSIA_ELASTICSEARCH_HOSTS=http://127.0.0.1:18114

# ── (B) Your LLM — THIS is the one thing you must supply ──────────────────────
# gpt-5 is a REASONING model. It rejects `temperature` and rejects `max_tokens`,
# so this file leaves TEMPERATURE and TOP_P unset and uses
# MAX_COMPLETION_TOKENS rather than MAX_TOKENS. Those three settings further
# down are already correct — do not "fix" them by uncommenting.
BIOGNOSIA_LLM_PROVIDER=openai
BIOGNOSIA_LLM_MODEL=gpt-5
BIOGNOSIA_LLM_API_KEY=<your-openai-api-key>

# ══════════════════════════════════════════════════════════════════════════════
#  Everything below has a working default.
# ══════════════════════════════════════════════════════════════════════════════

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Strongly recommended, not strictly required. None of the four models is gated,
# so anonymous download does work; but the reranker starts many worker processes
# that each contact the Hub, and anonymous requests are rate-limited. Hitting
# HTTP 429 during model load turns into a startup failure. A free token raises
# that limit. Models download on first run (~5 GB) and are cached after.
#
# LICENCE — please read. jinaai/jina-reranker-v2-base-multilingual is
# CC-BY-NC-4.0: NON-COMMERCIAL use only. It downloads without any agreement
# step, so nothing will stop you — the obligation is yours. See NOTICE for all
# four model licences.
HF_TOKEN=<your-huggingface-token>

# ── LLM, continued ────────────────────────────────────────────────────────────
# provider=openai covers any OpenAI-compatible endpoint — OpenAI itself, Groq,
# vLLM, LM Studio, Ollama's /v1. Set base_url for anything that is not
# api.openai.com; it MUST include the /v1 suffix. provider=anthropic talks to
# the Anthropic API and ignores base_url.
# BIOGNOSIA_LLM_BASE_URL=http://localhost:11434/v1
BIOGNOSIA_LLM_TIMEOUT=300

# false strips <think>...</think> reasoning blocks out of the answer.
BIOGNOSIA_LLM_ENABLE_COT=false

# An UNSET parameter here is not sent to the API at all — and, importantly, a
# value the pipeline tries to pass is then dropped too. That is exactly what a
# reasoning model such as gpt-5 needs, because parts of the pipeline would
# otherwise send temperature=0.0 and be rejected. Leave both commented out for
# gpt-5; set them only if you switch to a model that accepts them.
# BIOGNOSIA_LLM_TEMPERATURE=0.2
# BIOGNOSIA_LLM_TOP_P=1.0

# Output cap. MAX_COMPLETION_TOKENS is the modern parameter and the one gpt-5
# accepts; setting it also converts any max_tokens the pipeline passes into
# max_completion_tokens, so nothing sends the rejected parameter. Leave
# MAX_TOKENS unset for gpt-5.
BIOGNOSIA_LLM_MAX_COMPLETION_TOKENS=8192
# BIOGNOSIA_LLM_MAX_TOKENS=

# ── Knowledge-base naming ─────────────────────────────────────────────────────
# Milvus collection prefix: <workspace>_chunks / _entities / _relationships.
BIOGNOSIA_MILVUS_WORKSPACE=lightrag
BIOGNOSIA_MONGODB_DATABASE=paper_db
BIOGNOSIA_MONGODB_COLLECTION=papers
BIOGNOSIA_REDIS_DB=0
# BIOGNOSIA_NEO4J_DATABASE=
BIOGNOSIA_ELASTICSEARCH_ENABLED=true
# BIOGNOSIA_ELASTICSEARCH_USERNAME=
# BIOGNOSIA_ELASTICSEARCH_PASSWORD=

# ── Config file ───────────────────────────────────────────────────────────────
MCP_RAG_CONFIG_PATH=config/rag-web.conf
MCP_LOG_LEVEL=INFO

# ── GPU device placement (embedding + rerank) ────────────────────────────────
# BIOGNOSIA_EMBEDDING_DEVICE sets all three embedding models at once; the
# per-model vars below override it. Rerank devices are set separately. With more
# than one GPU you can spread the models across cards.
BIOGNOSIA_EMBEDDING_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_CHUNK_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_LABEL_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_STAGE2_DEVICE=cuda:0
BIOGNOSIA_RERANK_DEVICE=cuda:0
BIOGNOSIA_RERANK_STAGE1_DEVICE=cuda:0

# ── Rerank worker pools (VRAM sizing) ────────────────────────────────────────
# Each rerank worker is a separate process holding its own CUDA context and
# model copy. These two are the resident-memory knobs; the batch settings in
# config/rag-web.conf drive the much larger transient peak while reranking.
# See the sizing section of README.md before choosing a card.
BIOGNOSIA_RERANK_NUM_WORKERS=4
BIOGNOSIA_RERANK_STAGE1_NUM_WORKERS=4

# ── File paths ───────────────────────────────────────────────────────────────
# Detailed per-query debug logs (empty = disabled).
# BIOGNOSIA_QUERY_LOG_DIR=./log/query
# N-gram entity statistics TSV (needed for n-gram entity matching).
# BIOGNOSIA_NGRAM_STATISTICS_FILE=./data/entity_statistics.tsv

# ── Legacy (outside the BIOGNOSIA_ scheme) ───────────────────────────────────
# Read directly by the second-stage entity-discovery parser (disabled by
# default). Comma-separated collection names to exclude; appended to the config.
# EXCLUDE_COLLECTIONS=Taxonomy

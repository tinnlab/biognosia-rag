# Biognosia RAG — environment configuration. Copy to `.env` and edit.
#
# Only variables that are set (non-empty) override the defaults in
# config/rag-web.conf. Secrets belong here and never in the committed config.
# `.env` is gitignored.

# ══════════════════════════════════════════════════════════════════════════════
#  FILL THESE IN — nothing else in this file needs editing to get started.
#
#  (A) Lab-hosted knowledge base: endpoints and credentials.
#
#      NOT PUBLISHED YET. Every value in this group is a PLACEHOLDER, and the
#      code refuses to start while any `-tbd>` remains, naming the variable.
#      Replace them with the values published alongside the paper.
# ══════════════════════════════════════════════════════════════════════════════

# Milvus — dense vector store (required).
BIOGNOSIA_MILVUS_HOST=<public-endpoint-tbd>
BIOGNOSIA_MILVUS_PORT=<public-port-tbd>

# Neo4j — knowledge graph (required).
BIOGNOSIA_NEO4J_URI=bolt://<public-endpoint-tbd>:<public-port-tbd>
BIOGNOSIA_NEO4J_USERNAME=<lab-credential-tbd>
BIOGNOSIA_NEO4J_PASSWORD=<lab-credential-tbd>

# Redis — chunk text and entity->chunk index (required).
BIOGNOSIA_REDIS_HOST=<public-endpoint-tbd>
BIOGNOSIA_REDIS_PORT=<public-port-tbd>

# MongoDB — paper metadata used to render citations (soft: without it the
# answer still comes back, but footnotes degrade to raw chunk text).
# If the endpoint requires auth, use mongodb://user:password@host:port and note
# that with no path in the URI the driver authenticates against `admin`; append
# `?authSource=paper_db` if the user was created inside paper_db instead.
BIOGNOSIA_MONGODB_URI=mongodb://<public-endpoint-tbd>:<public-port-tbd>

# Elasticsearch — BM25/hybrid keyword search (soft: retrieval falls back to the
# vector and graph paths if it is unreachable).
BIOGNOSIA_ELASTICSEARCH_HOSTS=http://<public-endpoint-tbd>:<public-port-tbd>

# ══════════════════════════════════════════════════════════════════════════════
#  (B) Your own credentials.
#
#      HF_TOKEN — strongly recommended, not strictly required. None of the four
#      models is gated, so anonymous download does work; but the reranker starts
#      many worker processes that each contact the HuggingFace Hub, and
#      anonymous requests are rate-limited. Hitting HTTP 429 during model load
#      turns into a startup failure and a restart loop. A free HuggingFace
#      access token raises that limit. Where it is used differs by mode:
#        - plain Python: at RUN time (models download on first use, ~5 GB)
#        - Docker:       at BUILD time only, via
#                        `docker build --build-arg HF_TOKEN=... .`
#                        (the running container needs no token)
#
#      LICENCE — please read. jinaai/jina-reranker-v2-base-multilingual is
#      CC-BY-NC-4.0: NON-COMMERCIAL use only. It downloads without any
#      agreement step, so nothing will stop you — the obligation is yours. See
#      NOTICE for all four model licences.
# ══════════════════════════════════════════════════════════════════════════════
HF_TOKEN=<your-huggingface-token>

# Your LLM key. Not needed if you point BIOGNOSIA_LLM_BASE_URL at a local
# endpoint that takes no auth (vLLM, Ollama, an unauthenticated proxy).
BIOGNOSIA_LLM_API_KEY=<your-llm-api-key>

# ══════════════════════════════════════════════════════════════════════════════
#  Everything below has a working default.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM ───────────────────────────────────────────────────────────────────────
# Used by the plain-Python path (examples/query.py) and by the MCP server when
# MCP_LLM_MODE=standalone.
#
# Use provider=openai for ANY OpenAI-compatible endpoint — OpenAI itself, Groq,
# vLLM, LM Studio, or Ollama's /v1. Set base_url for anything that is not
# api.openai.com; it MUST include the /v1 suffix. provider=anthropic talks to
# the Anthropic API and ignores base_url.
BIOGNOSIA_LLM_PROVIDER=openai
BIOGNOSIA_LLM_MODEL=gpt-4o-mini
# BIOGNOSIA_LLM_BASE_URL=http://localhost:11434/v1
BIOGNOSIA_LLM_TIMEOUT=300

# false strips <think>...</think> reasoning blocks out of the answer.
BIOGNOSIA_LLM_ENABLE_COT=false

# Optional. LEAVING THESE UNSET MEANS "do not send this parameter at all",
# which is what lets reasoning models that reject temperature/max_tokens work.
# Setting MAX_COMPLETION_TOKENS makes MAX_TOKENS be ignored.
# BIOGNOSIA_LLM_TEMPERATURE=0.2
# BIOGNOSIA_LLM_TOP_P=1.0
BIOGNOSIA_LLM_MAX_TOKENS=8192
# BIOGNOSIA_LLM_MAX_COMPLETION_TOKENS=

# ── Server (MCP mode only) ────────────────────────────────────────────────────
# How the MCP server obtains generation:
#   sampling   (default) it generates nothing itself and asks the connected MCP
#              client for every completion via sampling/createMessage. Requires
#              a sampling-capable client.
#   standalone it calls the LLM above itself. No sampling client needed — a
#              plain curl can drive it.
MCP_LLM_MODE=standalone

MCP_RAG_CONFIG_PATH=config/rag-web.conf
MCP_LOG_LEVEL=INFO
# MCP_LOG_FILE=/app/log/mcp.log

# Set to 1 to run WITHOUT any database, LLM or GPU: skips RAGApp init entirely
# and makes query_rag perform a minimal protocol round-trip only. For checking
# the MCP handshake against a client.
MCP_TEST_MODE=0
# MCP_TEST_PROMPT=This is a Biognosia connectivity test. Reply with exactly the single word: PONG.

# Optional shared-secret auth. When set, every /mcp request must send
# `Authorization: Bearer <token>`. In sampling mode the client must send the
# same header on its sampling replies, or they are rejected and the call hangs
# until the 600 s timeout.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-secret

# Protocol version to negotiate when the client omits/uses an unknown one.
MCP_PROTOCOL_VERSION_FALLBACK=2025-11-25

# Directory for full-payload response dumps. Empty = disabled.
# MCP_RESPONSE_LOG_DIR=/app/log

# Max concurrent in-flight tool calls (each drives the full GPU/DB pipeline).
# 0 or negative = unlimited.
MCP_MAX_CONCURRENT_TOOL_CALLS=8
# Reject request bodies larger than this many bytes (default 1 MiB).
# MCP_MAX_BODY_BYTES=1048576

# ── Knowledge-base naming ─────────────────────────────────────────────────────
# Milvus collection prefix: <workspace>_chunks / _entities / _relationships.
BIOGNOSIA_MILVUS_WORKSPACE=lightrag
BIOGNOSIA_MONGODB_DATABASE=paper_db
BIOGNOSIA_MONGODB_COLLECTION=papers
BIOGNOSIA_REDIS_DB=0
# BIOGNOSIA_REDIS_PASSWORD=
# BIOGNOSIA_NEO4J_DATABASE=
BIOGNOSIA_ELASTICSEARCH_ENABLED=true
# BIOGNOSIA_ELASTICSEARCH_USERNAME=
# BIOGNOSIA_ELASTICSEARCH_PASSWORD=

# ── GPU device placement (embedding + rerank) ────────────────────────────────
# BIOGNOSIA_EMBEDDING_DEVICE sets all three embedding models at once; the
# per-model vars below override it. Rerank devices are set separately. With more
# than one GPU you can spread the models across cards.
BIOGNOSIA_EMBEDDING_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_CHUNK_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_LABEL_DEVICE=cuda:0
# BIOGNOSIA_EMBEDDING_STAGE2_DEVICE=cuda:0
BIOGNOSIA_RERANK_DEVICE=cuda:0
BIOGNOSIA_RERANK_STAGE1_DEVICE=cuda:0

# OPTIONAL, Docker only. All GPUs are exposed to the container by default and
# the *_DEVICE vars above pick among them by ordinal (cuda:2 = physical GPU 2) —
# that is the normal way to run, and the only one that can SPREAD models across
# cards. Set this only to harden a host shared with other users: it limits which
# cards are visible so the app cannot allocate on someone else's GPU by mistake.
# It also RENUMBERS them — a container given one card sees it as cuda:0 whatever
# its physical index — so the *_DEVICE vars must then use the VISIBLE ordinal.
# Do not mix the two (…gpu=2 together with cuda:2 fails: invalid device ordinal).
# BIOGNOSIA_GPU_DEVICE=nvidia.com/gpu=2

# Host port the MCP server is published on (Docker only).
# BIOGNOSIA_HOST_PORT=8081

# ── Rerank worker pools (VRAM sizing) ────────────────────────────────────────
# Each rerank worker is a separate process holding its own CUDA context and
# model copy, so these drive VRAM directly: roughly 1.1 GB per stage-2 worker,
# 0.5 GB per stage-1 worker, plus about 3.7 GB for the main process — so 4 + 4
# workers is around 10 GB. Unset = the config-file defaults (8 and 8, ~16.5 GB).
# rag-web.conf's own guidance for num_workers is "2-4 for GPU (due to VRAM
# limits)"; fewer workers costs little on typical queries.
BIOGNOSIA_RERANK_NUM_WORKERS=4
BIOGNOSIA_RERANK_STAGE1_NUM_WORKERS=4

# ── File paths ───────────────────────────────────────────────────────────────
# Detailed per-query debug logs (empty = disabled).
# BIOGNOSIA_QUERY_LOG_DIR=/app/log/query
# N-gram entity statistics TSV (needed for n-gram entity matching).
# BIOGNOSIA_NGRAM_STATISTICS_FILE=/app/data/entity_statistics.tsv

# ── Legacy (outside the BIOGNOSIA_ scheme) ───────────────────────────────────
# Read directly by the second-stage entity-discovery parser (disabled by
# default). Comma-separated collection names to exclude; appended to the config.
# EXCLUDE_COLLECTIONS=Taxonomy

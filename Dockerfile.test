# Biognosia RAG — slim CPU test image.
#
# For local validation of the MCP sampling handshake with a client, WITHOUT the
# knowledge-base endpoints or a GPU. Run with -e MCP_TEST_MODE=1. Because test
# mode defers the torch/transformers/DB import chain, this image needs only the
# web stack and builds in seconds.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-test.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements-test.txt

COPY src_rag_web/ ./src_rag_web/
COPY config/ ./config/

RUN useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8081

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=5 \
    CMD curl -fsS http://localhost:8081/health || exit 1

CMD ["uvicorn", "src_rag_web.mcp_server:app", \
     "--host", "0.0.0.0", "--port", "8081", "--workers", "1"]
